/* ================================
   GLOBAL
================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, Helvetica, Arial, sans-serif;
    background: #ffffff;
    color: #1f2933;
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

.container {
    width: min(1100px, 90%);
    margin: 0 auto;
}


/* ================================
   NAVIGATION
================================ */

nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid #e5e7eb;
    backdrop-filter: blur(10px);
}

.nav-container {
    width: min(1100px, 90%);
    margin: 0 auto;
    height: 72px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.5px;
}

.nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
}

.nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: #4b5563;
    transition: color 0.2s ease;
}

.nav-links a:hover {
    color: #173f35;
}


/* ================================
   HERO
================================ */

.hero {
    padding: 120px 0 110px;
    border-bottom: 1px solid #e5e7eb;
}

.hero-content {
    max-width: 850px;
}

.hero-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #356859;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: clamp(46px, 7vw, 76px);
    line-height: 1.02;
    letter-spacing: -3px;
    font-weight: 750;
    color: #17211f;
    margin-bottom: 25px;
}

.hero h1 span {
    color: #356859;
}

.hero-description {
    max-width: 700px;
    font-size: 20px;
    line-height: 1.7;
    color: #5b6570;
    margin-bottom: 35px;
}

.hero-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.button {
    display: inline-block;
    padding: 12px 20px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.button-primary {
    background: #173f35;
    color: white;
}

.button-primary:hover {
    background: #102e27;
    transform: translateY(-1px);
}

.button-secondary {
    border: 1px solid #d1d5db;
    color: #374151;
    background: white;
}

.button-secondary:hover {
    border-color: #173f35;
    color: #173f35;
}


/* ================================
   SECTIONS
================================ */

section {
    padding: 90px 0;
}

.section-header {
    margin-bottom: 45px;
}

.section-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #356859;
    margin-bottom: 8px;
}

.section-title {
    font-size: 36px;
    letter-spacing: -1.5px;
    color: #17211f;
}

.section-description {
    max-width: 650px;
    margin-top: 12px;
    color: #68727d;
}


/* ================================
   ABOUT
================================ */

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 70px;
}

.about-title {
    font-size: 25px;
    line-height: 1.3;
    color: #17211f;
}

.about-text {
    color: #5b6570;
    font-size: 16px;
}

.about-text p {
    margin-bottom: 18px;
}


/* ================================
   EXPERIENCE
================================ */

.experience-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 45px;

    padding: 30px 0;
    border-top: 1px solid #e5e7eb;
}

.experience-date {
    font-size: 13px;
    color: #7a838c;
}

.experience-title {
    font-size: 20px;
    font-weight: 650;
    color: #17211f;
    margin-bottom: 4px;
}

.experience-company {
    font-size: 14px;
    color: #356859;
    font-weight: 600;
    margin-bottom: 12px;
}

.experience-description {
    color: #5b6570;
}


/* ================================
   PROJECTS
================================ */

.projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.project-card {
    border: 1px solid #e1e5e8;
    border-radius: 8px;
    padding: 30px;

    background: #ffffff;

    transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.project-card:hover {
    transform: translateY(-4px);
    border-color: #b8c9c3;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
}

.project-number {
    font-size: 12px;
    font-weight: 700;
    color: #356859;
    letter-spacing: 1px;
    margin-bottom: 25px;
}

.project-title {
    font-size: 22px;
    color: #17211f;
    margin-bottom: 10px;
}

.project-description {
    color: #68727d;
    font-size: 15px;
    margin-bottom: 20px;
}

.project-tools {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.project-tools span {
    padding: 5px 9px;
    border-radius: 4px;
    background: #f3f5f4;
    color: #4d5b56;
    font-size: 11px;
    font-weight: 600;
}


/* ================================
   SKILLS
================================ */

.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.skill-group {
    padding: 25px;
    background: #f7f8f7;
    border: 1px solid #e5e7eb;
    border-radius: 7px;
}

.skill-group h3 {
    font-size: 16px;
    margin-bottom: 12px;
    color: #17211f;
}

.skill-group p {
    font-size: 14px;
    color: #68727d;
}


/* ================================
   CONTACT
================================ */

.contact {
    background: #f7f8f7;
    border-top: 1px solid #e5e7eb;
}

.contact-content {
    max-width: 700px;
}

.contact h2 {
    font-size: 42px;
    letter-spacing: -1.5px;
    margin-bottom: 15px;
}

.contact p {
    color: #68727d;
    margin-bottom: 25px;
}


/* ================================
   FOOTER
================================ */

footer {
    padding: 30px 0;
    border-top: 1px solid #e5e7eb;
    color: #8a9299;
    font-size: 13px;
}

.footer-container {
    width: min(1100px, 90%);
    margin: 0 auto;

    display: flex;
    justify-content: space-between;
}


/* ================================
   MOBILE
================================ */

@media (max-width: 750px) {

    .nav-container {
        height: auto;
        padding: 18px 0;
        flex-direction: column;
        gap: 12px;
    }

    .nav-links {
        gap: 18px;
    }

    .hero {
        padding: 80px 0;
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .hero-description {
        font-size: 17px;
    }

    section {
        padding: 65px 0;
    }

    .about-grid {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .projects-grid {
        grid-template-columns: 1fr;
    }

    .skills-grid {
        grid-template-columns: 1fr;
    }

    .experience-item {
        grid-template-columns: 1fr;
        gap: 8px;
    }

    .footer-container {
        flex-direction: column;
        gap: 10px;
    }
}
